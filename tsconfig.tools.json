{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "scripts/*.ts",
    "apps/api/test/**/*.ts",
    "apps/web/test/*.ts",
    "e2e/*.ts",
    "playwright.config.ts"
  ]
}
