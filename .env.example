NODE_ENV=development
PORT=3100
WEB_ORIGIN=http://localhost:5173
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://amp:amp_local_only@localhost:5434/amp
# Seed requires both flags; never seed demo credentials into a deployed database.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=LocalStudy2026!
SERVE_WEB=false
TRUST_PROXY=false
# Private media directory; default for development is .local/assets.
# Production requires an absolute path and a persistent volume.
# ASSET_DIRECTORY=/absolute/path/to/private-assets
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
