{
  "name": "@amp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:seed": "tsx src/database/cli.ts seed",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "accounts": "tsx src/database/accounts.ts"
  },
  "dependencies": {
    "@amp/contracts": "0.1.0",
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "dotenv": "^17.2.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0"
  }
}
